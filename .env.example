# Google Cloud OAuth 2.0 client (Desktop/Web) for Google Health API
FOODY_GOOGLE_CLIENT_ID=
FOODY_GOOGLE_CLIENT_SECRET=

# User tokens from OAuth authorization-code flow (access_type=offline)
